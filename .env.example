DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BOLNA_API_KEY=
BOLNA_AGENT_ID=
SARVAM_API_KEY=

# Supabase project settings. Use the same project for Auth and Postgres.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY
SHOPKEEPER_PHONE=+91XXXXXXXXXX
DEMO_AUTH_BYPASS=false
SHOP_NAME=My kirana shop
SHOP_TYPE=Neighborhood kirana/general store
SHOP_LOCATION=
SHOP_LANGUAGE=Hindi/Hinglish
SHOP_CALLING_HOURS=10:00 AM - 1:00 AM
MAX_CALL_ATTEMPTS=3
CUSTOMER_DATA_RETENTION_DAYS=30
BOLNA_WEBHOOK_SECRET=
BOLNA_WEBHOOK_ALLOWED_IPS=13.203.39.153,13.126.9.249,13.202.133.53
CALL_TRIGGER_COOLDOWN_MINUTES=5

# Vite exposes only VITE_ variables in the browser. This must be the public anon key,
# never a service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY
